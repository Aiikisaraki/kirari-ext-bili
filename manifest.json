    "idleTimeoutMs": 300000
  },
  "contributions": [
    {
      "type": "service",
      "id": "bili.explore",
      "title": "B站探索"
    }
  ],
  "permissions": [],
  "resources": {
    "minRamMb": 128,
    "gpuRecommended": false
  }
}
